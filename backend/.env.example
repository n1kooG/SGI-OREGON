PORT=3000
# Conexión de la API: rol de aplicación sin privilegios de propietario (ver db/07_rol_aplicacion.sql y backend/README.md).
# En desarrollo local puedes seguir usando tu propio usuario de PostgreSQL.
DATABASE_URL=postgres://TU_USUARIO_MAC@localhost:5432/sgi_oregon
# Solo para scripts de administración (scripts/arranque-produccion.mjs): rol propietario. No lo uses en la API.
# DATABASE_URL_MIGRACION=postgres://sgi_owner:CLAVE@localhost:5432/sgi_oregon
# Opcional en pruebas: activa las pruebas de privilegios conectando como el rol de aplicación.
# TEST_APP_DATABASE_URL=postgres://sgi_app:CLAVE@localhost:5432/sgi_oregon_pruebas
REDIS_URL=redis://localhost:6379
# Genera uno propio:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=30m
CORS_ORIGIN=http://localhost:5173
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
KPI_TTL_SEGUNDOS=30
# Producción (RDS exige SSL): DB_SSL=true
DB_SSL=false
# Sesión: minutos de inactividad antes de expirar
SESSION_IDLE_MINUTES=15
# Almacenamiento S3 (en desarrollo déjalo en false)
STORAGE_ENABLED=false
# true = ENTREGADO exige firma o nombre del receptor (por defecto son opcionales)
EXIGIR_RECEPTOR_ENTREGA=false
S3_BUCKET=
S3_REGION=sa-east-1
